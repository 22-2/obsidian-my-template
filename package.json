{
	"name": "obsidian-sample-plugin",
	"version": "1.0.0",
	"description": "This is a sample plugin for Obsidian (https://obsidian.md)",
	"main": "main.js",
	"scripts": {
		"dev": "pnpm dlx tsx esbuild.config.mts",
		"build": "pnpm dlx tsx esbuild.config.mts production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"check-types": "tsc -noEmit -skipLibCheck",
		"repomix": "pnpm dlx repomix && code ./repomix-output.md"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@types/node": "24.3.1",
		"builtin-modules": "5.0.0",
		"esbuild": "0.25.9",
		"obsidian-typings": "4.50.0",
		"obsidian": "^1.8.7",
		"tslib": "^2.8.1",
		"typescript": "5.9.2"
	}
}
