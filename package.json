{
	"name": "obsidian-my-new-plugin",
	"version": "1.0.0",
	"description": "This is a sample plugin for Obsidian (https://obsidian.md)",
	"keywords": [],
	"license": "MIT",
	"author": "",
	"main": "main.js",
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"release": "release-it",
		"release:with-versions": "release-it --config .release-it.with-versions.json",
		"lint": "eslint .",
		"setup": "node scripts/setup-template.mjs",
		"test": "vitest run",
		"verify-build": "node scripts/verify-build.mjs",
		"check-types": "tsc --noEmit --skipLibCheck && pnpm lint"
	},
	"dependencies": {
		"consola": "^3.4.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@obsidian-typings/obsidian-public-latest": "^6.38.0",
		"@release-it/bumper": "^8.0.1",
		"@release-it/conventional-changelog": "^12.0.2",
		"@types/node": "26.6.3",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"jsonc-parser": "^3.3.1",
		"obsidian": "^1.13.1",
		"release-it": "^21.1.0",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
