{
	"name": "obsidian-nobit",
	"type": "module",
	"version": "1.0.0",
	"description": "This is a sample plugin for Obsidian (https://obsidian.md)",
	"main": "main.js",
	"scripts": {
		"dev": "pnpm dlx tsx esbuild.config.mts",
		"build": "pnpm dlx tsx esbuild.config.mts production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"check-types": "tsc -noEmit -skipLibCheck",
		"repomix": "pnpm dlx repomix && code ./repomix-output.md",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:e2e": "playwright test",
		"test:e2e:example": "pnpm playwright test e2e/specs/example.spec.ts --project=chromium",
		"test:e2e:debug": "cross-env DEBUG=pw:api playwright test"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "2.2.5",
		"@electron/asar": "^4.0.1",
		"@playwright/test": "^1.55.1",
		"@tsconfig/svelte": "^5.0.5",
		"@types/node": "24.6.2",
		"builtin-modules": "5.0.0",
		"chalk": "^5.6.2",
		"dotenv": "^17.2.3",
		"electron": "^38.2.1",
		"esbuild": "0.25.10",
		"esbuild-svelte": "^0.9.3",
		"loglevel-plugin-prefix": "^0.8.4",
		"obsidian": "^1.10.0",
		"obsidian-typings": "4.58.0",
		"playwright": "^1.55.1",
		"svelte-preprocess": "^6.0.3",
		"tiny-invariant": "^1.3.3",
		"tslib": "^2.8.1",
		"typescript": "5.9.3",
		"vitest": "^3.2.4",
		"yaml": "^2.8.1"
	},
	"dependencies": {
		"date-fns": "^4.1.0",
		"loglevel": "^1.9.2",
		"lucide-svelte": "^0.544.0",
		"svelte": "^5.39.8",
		"zod": "^4.1.11"
	},
	"packageManager": "pnpm@10.18.0+sha512.e804f889f1cecc40d572db084eec3e4881739f8dec69c0ff10d2d1beff9a4e309383ba27b5b750059d7f4c149535b6cd0d2cb1ed3aeb739239a4284a68f40cfa"
}
